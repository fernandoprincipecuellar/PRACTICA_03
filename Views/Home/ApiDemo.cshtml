@{
    ViewData["Title"] = "API Demo";
}

<h2>API Demo</h2>

<section>
    <h3>Tareas (locales)</h3>
    <button id="btn-load-tareas" class="btn btn-sm btn-primary">Cargar tareas</button>
    <pre id="out-tareas" style="white-space:pre-wrap;background:#f8f9fa;padding:10px;border:1px solid #ddd;margin-top:8px;"></pre>
</section>

<section style="margin-top:20px;">
    <h3>Tareas externas (jsonplaceholder)</h3>
    <button id="btn-load-externas" class="btn btn-sm btn-secondary">Cargar tareas externas</button>
    <pre id="out-externas" style="white-space:pre-wrap;background:#f8f9fa;padding:10px;border:1px solid #ddd;margin-top:8px;"></pre>
</section>

<section style="margin-top:20px;">
    <h3>Análisis de sentimiento</h3>
    <textarea id="txt-comentario" rows="3" style="width:100%" placeholder="Escribe un comentario..."></textarea>
    <button id="btn-analizar" class="btn btn-sm btn-success" style="margin-top:8px;">Analizar sentimiento</button>
    <pre id="out-ml" style="white-space:pre-wrap;background:#f8f9fa;padding:10px;border:1px solid #ddd;margin-top:8px;"></pre>
</section>

<script>
document.getElementById('btn-load-tareas').addEventListener('click', async () => {
    const out = document.getElementById('out-tareas');
    out.textContent = 'Cargando...';
    try {
        const res = await fetch('/api/tareas');
        const json = await res.json();
        out.textContent = JSON.stringify(json, null, 2);
    } catch (e) {
        out.textContent = 'Error: ' + e;
    }
});

document.getElementById('btn-load-externas').addEventListener('click', async () => {
    const out = document.getElementById('out-externas');
    out.textContent = 'Cargando...';
    try {
        const res = await fetch('/api/tareas-externas');
        const json = await res.json();
        out.textContent = JSON.stringify(json.slice(0,20), null, 2);
    } catch (e) {
        out.textContent = 'Error: ' + e;
    }
});

document.getElementById('btn-analizar').addEventListener('click', async () => {
    const out = document.getElementById('out-ml');
    const comentario = document.getElementById('txt-comentario').value;
    if (!comentario) { out.textContent = 'Escribe un comentario.'; return; }
    out.textContent = 'Analizando...';
    try {
        const res = await fetch('/api/ml/sentimiento', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ comentario })
        });
        const json = await res.json();
        out.textContent = JSON.stringify(json, null, 2);
    } catch (e) {
        out.textContent = 'Error: ' + e;
    }
});
</script>
